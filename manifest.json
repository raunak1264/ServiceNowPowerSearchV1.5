{
  "manifest_version": 3,
  "name": "ServiceNow Power Search",
  "version": "1.5.0",
  "description": "Keyboard-first ServiceNow query builder with dynamic field selection, multi-condition search, and reference field resolver.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.service-now.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SN Power Search",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
